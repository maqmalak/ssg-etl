COMPOSE_PROJECT_NAME=ssg-etl
AIRFLOW_PROJ_DIR=.
AIRFLOW_UID=1000
AIRFLOW_GID=1000

# Image tag only if your compose references AIRFLOW_IMAGE_NAME
AIRFLOW_IMAGE_NAME=airflow-custom:2.11.0-spark

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
