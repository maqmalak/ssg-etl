# Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.11.0
AIRFLOW_UID=50000
AIRFLOW_GID=50000
AIRFLOW_PROJ_DIR=.

# Database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow Admin User
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Additional Requirements
# _PIP_ADDITIONAL_REQUIREMENTS=dask,distributed,redis,boto3,psycopg2-binary,dummy-package

# Docker Resource Limits
COMPOSE_PROJECT_NAME=airflow-ssg-etl

# Custom Environment Variables for Resource Management
AIRFLOW__CORE__PARALLELISM=16
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW__CELERY__WORKER_CONCURRENCY=8
AIRFLOW__WEBSERVER__WORKERS=2
